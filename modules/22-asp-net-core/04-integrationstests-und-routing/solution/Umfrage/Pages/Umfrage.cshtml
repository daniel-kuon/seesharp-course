@page
@model UmfrageModel
<h1>Abstimmen</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <p>
        <label asp-for="Eingabe.Partei"></label>
        <input asp-for="Eingabe.Partei" />
        <span asp-validation-for="Eingabe.Partei"></span>
    </p>
    <p>
        <label asp-for="Eingabe.Name"></label>
        <input asp-for="Eingabe.Name" />
    </p>
    <button type="submit">Abschicken</button>
</form>

<h2>Zwischenstand</h2>
<table>
    @foreach (var e in Model.Ergebnisse)
    {
        <tr><td>@e.Partei</td><td>@e.Stimmen</td></tr>
    }
</table>
